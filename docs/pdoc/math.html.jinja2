{# Override pdoc's default MathJax with KaTeX (faster, lighter). #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16/dist/contrib/auto-render.min.js"></script>
<script>
    const renderMath = () => renderMathInElement(document.body, {
        delimiters: [
            {left: "$$", right: "$$", display: true},
            {left: "$", right: "$", display: false},
            {left: "\\(", right: "\\)", display: false},
            {left: "\\[", right: "\\]", display: true},
        ],
        throwOnError: false,
    });
    document.addEventListener("DOMContentLoaded", () => {
        renderMath();
        /* Re-render when DOM content changes, for example during search. */
        new MutationObserver(renderMath).observe(
            document.querySelector("main.pdoc").parentNode,
            {childList: true}
        );
    });
</script>
<style>
    .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
    }
</style>
